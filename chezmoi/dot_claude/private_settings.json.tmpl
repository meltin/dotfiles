{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1"
  },
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(git add:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Bash(rm -rf ~/.*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay -v 0.1 /System/Library/Sounds/Funk.aiff"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/japanese-guard.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay -v 0.1 /System/Library/Sounds/Funk.aiff"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5,
            "statusMessage": "Rex: session context"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$REX_SESSION\" ] && rex session rename \"$REX_SESSION\" \"$(basename \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo \"$PWD/.\")\")\")\" >/dev/null 2>&1 || true",
            "timeout": 5,
            "statusMessage": "Rex: set session name to project"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"${CLAUDE_PROJECT_DIR:-$PWD}/\" in \"$HOME/Downloads/\"*) echo \"~/Downloads では使えません。別のディレクトリで起動してください\" >&2; exit 2;; esac"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      },
      {
        "matcher": "mcp__.*__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/japanese-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*reply_to_review_comment.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/review-reply-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/commit-attribution-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/bin/python {{ .chezmoi.homeDir }}/.local/share/sidepulse/venv/lib/python3.13/site-packages/sidepulse/hook_entry.py --provider claude --log {{ .chezmoi.homeDir }}/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@2.2.33",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "hono@hono": true,
    "swift-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "images@claude-images": true,
    "yomiyasu@yomiyasu": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-images": {
      "source": {
        "source": "github",
        "repo": "meltin/claude-images"
      }
    },
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu"
      }
    },
    "hono": {
      "source": {
        "source": "github",
        "repo": "honojs/skills"
      }
    }
  },
  "outputStyle": "Explanatory",
  "language": "Japanese",
  "effortLevel": "high",
  "advisorModel": "fable",
  "showThinkingSummaries": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true
}
