{{- /* Herdr の main レイアウトの Agents を、リポジトリでまとめる mod（agents-by-repo）に替える。Herdr を更新したら chezmoi apply で作り直す */ -}}
{{- $main := joinPath .chezmoi.homeDir ".config/herdr-app/layouts/main.json" -}}
{{- if stat $main -}}
{{ output "jq" "(.. | objects | select(.id? == \"agents\") | .content.mod) = \"agents-by-repo\"" $main }}
{{- end -}}
